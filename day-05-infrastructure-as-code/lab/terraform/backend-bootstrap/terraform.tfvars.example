###############################################################################
# Day 05 — backend-bootstrap/terraform.tfvars.example
#
#   cp terraform.tfvars.example terraform.tfvars
#   # edit owner, then:
#   terraform init && terraform apply
#
# terraform.tfvars is GITIGNORED. terraform.tfvars.example is committed. That
# split is deliberate: the example documents the shape of the input, the real
# file holds your values, and the auditor (IAC-001) reads BOTH looking for
# secrets — because "I only put the password in tfvars" is not a mitigation
# when tfvars gets committed by the next person to run `git add -A`.
###############################################################################

aws_region  = "us-east-1"
aws_profile = "bootcamp"
owner       = "your-name-here"

# --- Silent-growth valve -----------------------------------------------------
# Versioning is on and cannot be turned off without losing your rollback path.
# This is what stops old state versions accumulating forever.
noncurrent_version_expiration_days = 30
abort_incomplete_upload_days       = 7

# --- Cost toggle -------------------------------------------------------------
# false = SSE-S3, free, satisfies IAC-007.
# true  = customer-managed KMS key, $1.00/month, gives you a revocable key.
enable_kms_encryption    = false
kms_deletion_window_days = 7

# --- Danger ------------------------------------------------------------------
# Leave this false until the very end of the lab. It lets `terraform destroy`
# empty and delete the bucket that describes your entire estate.
state_bucket_force_destroy = false
