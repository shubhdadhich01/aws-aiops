###############################################################################
# Day 10 — terraform.tfvars.example
#
# Copy to terraform.tfvars and edit. Set at minimum:
#   - owner
#   - notification_email
#
# Everything else defaults to a shape that produces STATE A (nothing ambient
# is configured). Turning the enable_* toggles to true one by one is the
# lab walkthrough.
###############################################################################

# 1. Identity
aws_region         = "us-east-1"
aws_profile        = "bootcamp"
owner              = "your-name-here"
notification_email = "you@example.com"

# 2. Naming
name_prefix = "cbc-day10"

# 3. Ambient-audit toggles — default off, STATE A is what you get with all off
enable_scheduler          = false
enable_archive_versioning = false
enable_archive_lifecycle  = false
enable_lambda_alarm       = false
enable_dashboard          = false
enable_athena_table       = false
enable_reference_arch     = false   # CP3 adds the composed Days 01–09 module

# 4. Thresholds
schedule_interval_days      = 7
lambda_error_alarm_threshold = 1
suppression_review_days     = 90
report_unread_days          = 7

sla_days_by_severity = {
  critical = 1
  high     = 3
  medium   = 7
  low      = 30
}

# 5. Reference-arch parameters (only used when enable_reference_arch = true)
reference_arch_instance_type = "t3.micro"

# 6. Cost callouts propagated from Day 09
log_retention_days             = 30
tag_coverage_threshold_percent = 90

# Lambda-side wiring
lambda_memory_mb       = 512
lambda_timeout_seconds = 300
